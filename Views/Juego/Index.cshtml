@model tp_escape.Models.JuegoViewModel
@{
    ViewData["Title"] = "Inicio del Escape";
}

<h2>Escape Room</h2>
<p>Ingresá tu nombre para comenzar la partida.</p>

<form asp-controller="Juego" asp-action="IngresarSala" method="post">
    <div class="mb-3">
        <label class="form-label">Nombre del participante</label>
        <input asp-for="NombreParticipante" class="form-control" placeholder="Ej: Ana" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Respuesta inicial</label>
        <input asp-for="Respuesta" class="form-control" placeholder="Código de la sala" />
    </div>

    <button type="submit" class="btn btn-primary">Comenzar</button>
</form>
