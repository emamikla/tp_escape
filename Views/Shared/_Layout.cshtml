<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - tp_escape</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/tp_escape.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="nav">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index">Escape Game</a>
            <div class="nav-links">
                <a asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                <a asp-area="" asp-controller="Escape" asp-action="Tutorial">Cómo jugar</a>
            </div>
        </nav>
    </header>

    <div class="page-shell">
        <main role="main" class="content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
