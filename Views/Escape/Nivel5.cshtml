<h2>YA NO QUEDA NADA! Ya llegamos al escondite final!</h2>
<p>En la entrada hay un código secreto con preguntas que debemos completar, ayudanos</p>

<iframe allow="fullscreen; autoplay; allow-top-navigation-by-user-activation" allowfullscreen width="795" height="690" frameborder="0" src="https://es.educaplay.com/juego/30455867-outer_banks.html"></iframe>

<form action='@Url.Action("FijarRespuesta", "Escape")' method="post">
    <input type="hidden" name="sala" value="5" />
    <input type="hidden" name="nombreUsuario" value="@ViewBag.NombreUsuario" />
    <label for="respuesta">Ingrese la combinación correcta:</label>
    <input type="text" id="respuesta" name="respuesta" required>
    <button type="submit">Enviar</button>
    @if (ViewBag.Error != null)
    {
        <p style="color: red;">@ViewBag.Error</p>
    }
</form>

<button type="button" id="mostrarPista" onclick="mostrarPista()">Mostrar pista</button>
<div id="pista" style="display: none; margin-top: 10px; padding: 10px; border: 1px solid #ccc; background-color: #f9f9f9; max-width: 500px;">
    Tenes que agarrar una letra de cada palabra (la primera letra es de la palabra 1 y así) y encontrar la palabra oculta.
</div>

<script src="~/js/script.js"></script>
