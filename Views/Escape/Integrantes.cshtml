@{
    ViewData["Title"] = "Integrantes";
}

<div class="integrantes-title">
    <h1>Nuestro Equipo</h1>
    <p>Conoce a los integrantes que hacen posible este Escape Game</p>
</div>

<section class="integrantes-grid">
    <div class="integrante-card">
        <img src="~/images/integrantes/integrante1.jpg" alt="Integrante 1" class="integrante-imagen" />
        <div class="integrante-info">
            <div class="integrante-nombre">Julieta romano</div>
            <div class="integrante-rol">Desarrolladora</div>
            <div class="integrante-descripcion">Backend y Base de Datos</div>
        </div>
    </div>

    <div class="integrante-card">
        <img src="~/images/integrantes/integrante2.jpg" alt="Integrante 2" class="integrante-imagen" />
        <div class="integrante-info">
            <div class="integrante-nombre">Jazmín Han</div>
            <div class="integrante-rol">Desarrolladora</div>
            <div class="integrante-descripcion">Team leader</div>
        </div>
    </div>

    <div class="integrante-card">
        <img src="~/images/integrantes/integrante3.jpg" alt="Integrante 3" class="integrante-imagen" />
        <div class="integrante-info">
            <div class="integrante-nombre">Emanuel Miklaski</div>
            <div class="integrante-rol">Desarrollador</div>
            <div class="integrante-descripcion">Fullstack developer</div>
        </div>
    </div>
</section>

<div class="volver-inicio">
    <a href="@Url.Action("Index", "Escape")" class="btn btn-primary">Volver al Inicio</a>
</div>

